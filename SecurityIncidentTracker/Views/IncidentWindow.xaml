<Window x:Class="SecurityIncidentTracker.Views.IncidentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security Incident Tracker - Incident Management"
        Height="760" Width="1180"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Top Navigation & Header -->
            <RowDefinition Height="Auto"/>
            <!-- Search & Filter Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area: DataGrid + Form -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP NAVIGATION & HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="← Back to Dashboard" Width="160" Height="36" 
                        Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12"
                        Cursor="Hand" Margin="0,0,20,0" Click="BtnBackToDashboard_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Security Incident Management" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Search, inspect, record, modify, and track incident lifecycles" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="6" Padding="12,6" Margin="0,0,12,0" BorderBrush="#334155" BorderThickness="1">
                    <TextBlock x:Name="lblUserBadge" Text="admin" FontSize="12" Foreground="#CBD5E1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
                <Button Content="Logout" Width="90" Height="36" 
                        Background="#334155" Foreground="#F87171" FontWeight="SemiBold" FontSize="12"
                        Cursor="Hand" Click="BtnLogout_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ROW 1: SEARCH & FILTER BAR -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="16,12" Margin="0,0,0,18" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search Input -->
                    <ColumnDefinition Width="280"/>
                    <!-- Severity Filter -->
                    <ColumnDefinition Width="170"/>
                    <!-- Status Filter -->
                    <ColumnDefinition Width="170"/>
                    <!-- Filter Buttons -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="*"/>
                    <!-- Record Counter -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Search (ID, Type, Description):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtSearch" Height="34" FontSize="13" 
                             Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1"
                             Padding="8,5" VerticalContentAlignment="Center" KeyDown="TxtSearch_KeyDown"/>
                </StackPanel>

                <!-- Severity Filter -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Filter by Severity:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbFilterSeverity" Height="34" FontSize="13" 
                              Background="#0F172A" Foreground="#000000" VerticalContentAlignment="Center"
                              SelectionChanged="Filter_SelectionChanged">
                        <ComboBoxItem Content="All Severities" IsSelected="True"/>
                        <ComboBoxItem Content="Low"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="High"/>
                        <ComboBoxItem Content="Critical"/>
                    </ComboBox>
                </StackPanel>

                <!-- Status Filter -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Filter by Status:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbFilterStatus" Height="34" FontSize="13" 
                              Background="#0F172A" Foreground="#000000" VerticalContentAlignment="Center"
                              SelectionChanged="Filter_SelectionChanged">
                        <ComboBoxItem Content="All Statuses" IsSelected="True"/>
                        <ComboBoxItem Content="Open"/>
                        <ComboBoxItem Content="Investigating"/>
                        <ComboBoxItem Content="Resolved"/>
                    </ComboBox>
                </StackPanel>

                <!-- Buttons: Apply Search & Reset -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                    <Button Content="🔍 Search" Width="90" Height="34" 
                            Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"
                            Cursor="Hand" Margin="0,0,8,0" Click="BtnSearch_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="↺ Reset" Width="80" Height="34" 
                            Background="#334155" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="12"
                            Cursor="Hand" Click="BtnResetFilters_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Record Count Indicator -->
                <Border Grid.Column="5" VerticalAlignment="Bottom" Background="#0F172A" CornerRadius="6" Padding="12,7" BorderBrush="#334155" BorderThickness="1">
                    <TextBlock x:Name="lblRecordCount" Text="Total: 0 Incidents" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                </Border>
            </Grid>
        </Border>

        <!-- ROW 2: MAIN CONTENT (SPLIT: DATAGRID & FORM) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- DataGrid Column -->
                <ColumnDefinition Width="*"/>
                <!-- Form Column -->
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: INCIDENTS DATAGRID -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="14" Margin="0,0,16,0" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Incidents Registry (Click a row to select for Edit / Delete)" 
                               FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="2,0,0,10"/>

                    <DataGrid Grid.Row="1" x:Name="dgIncidents" AutoGenerateColumns="False" 
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="#0F172A" RowBackground="#0F172A" AlternatingRowBackground="#1E293B"
                              Foreground="#E2E8F0" HorizontalGridLinesBrush="#334155" 
                              BorderBrush="#334155" BorderThickness="1"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                              SelectionChanged="DgIncidents_SelectionChanged">
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="#1E293B"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding IncidentType}" Width="135"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- RIGHT: INCIDENT DETAILS & CRUD FORM -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="20" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        
                        <!-- Form Header -->
                        <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="lblFormTitle" Text="📝 Add New Incident" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock x:Name="lblFormSubtitle" Text="Enter incident details and click Add" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Selected ID (Hidden or Read-only) -->
                        <TextBlock Text="Incident ID" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtIncidentId" Height="32" FontSize="12" IsReadOnly="True" 
                                 Background="#0F172A" Foreground="#64748B" BorderBrush="#334155" BorderThickness="1"
                                 Padding="8,5" Margin="0,0,0,12" Text="Auto-generated on Add"/>

                        <!-- Incident Type ComboBox -->
                        <TextBlock Text="Incident Type *" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbIncidentType" Height="34" FontSize="13" Margin="0,0,0,12">
                            <ComboBoxItem Content="Phishing"/>
                            <ComboBoxItem Content="Malware"/>
                            <ComboBoxItem Content="Brute Force"/>
                            <ComboBoxItem Content="Unauthorized Access"/>
                            <ComboBoxItem Content="Suspicious Activity"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>

                        <!-- Severity ComboBox -->
                        <TextBlock Text="Severity *" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbSeverity" Height="34" FontSize="13" Margin="0,0,0,12">
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Critical"/>
                        </ComboBox>

                        <!-- Status ComboBox -->
                        <TextBlock Text="Status *" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbStatus" Height="34" FontSize="13" Margin="0,0,0,12">
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="Investigating"/>
                            <ComboBoxItem Content="Resolved"/>
                        </ComboBox>

                        <!-- Date Picker -->
                        <TextBlock Text="Date *" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpDate" Height="34" FontSize="13" Margin="0,0,0,12"/>

                        <!-- Description TextBox -->
                        <TextBlock Text="Description *" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtDescription" Height="80" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap"
                                 Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569" BorderThickness="1"
                                 Padding="8,6" Margin="0,0,0,18"/>

                        <!-- Action Buttons -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Add Button -->
                            <Button x:Name="btnAdd" Grid.Column="0" Content="➕ Add Incident" Height="38" 
                                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                    Cursor="Hand" Margin="0,0,6,0" Click="BtnAdd_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- Update Button -->
                            <Button x:Name="btnUpdate" Grid.Column="1" Content="💾 Update" Height="38" 
                                    Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                    Cursor="Hand" Margin="6,0,0,0" IsEnabled="False" Click="BtnUpdate_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Delete Button -->
                            <Button x:Name="btnDelete" Grid.Column="0" Content="🗑️ Delete" Height="36" 
                                    Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                    Cursor="Hand" Margin="0,0,6,0" IsEnabled="False" Click="BtnDelete_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- Clear Form Button -->
                            <Button x:Name="btnClear" Grid.Column="1" Content="🧹 Clear Form" Height="36" 
                                    Background="#334155" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="12"
                                    Cursor="Hand" Margin="6,0,0,0" Click="BtnClear_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- Hint Box -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="10,8" BorderBrush="#334155" BorderThickness="1">
                            <TextBlock Text="💡 Tip: Select any row in the table to modify its values or delete it. Click 'Clear Form' to return to Add mode." 
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
