<Window x:Class="SecurityIncidentTracker.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security Incident Tracker - Login"
        Height="540" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0F172A"
        FontFamily="Segoe UI">

    <Grid>
        <!-- Center Card -->
        <Border Width="380" Background="#1E293B" CornerRadius="12" 
                Padding="30,35" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                
                <!-- Security Header Icon & Title -->
                <TextBlock Text="🛡️" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Security Incident Tracker" 
                           FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" 
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="College Minor Project | C# WPF &amp; SQLite" 
                           FontSize="12" Foreground="#94A3B8" 
                           HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <!-- Username Field -->
                <TextBlock Text="Username" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                <TextBox x:Name="txtUsername" Height="38" FontSize="14" 
                         Padding="10,8" Background="#0F172A" Foreground="#FFFFFF" 
                         BorderBrush="#475569" BorderThickness="1" 
                         VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                <!-- Password Field -->
                <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                <PasswordBox x:Name="txtPassword" Height="38" FontSize="14" 
                             Padding="10,8" Background="#0F172A" Foreground="#FFFFFF" 
                             BorderBrush="#475569" BorderThickness="1" 
                             VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                <!-- Error Message Display -->
                <TextBlock x:Name="lblError" Text="" Foreground="#F87171" 
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" 
                           HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed"/>

                <!-- Login Button -->
                <Button x:Name="btnLogin" Content="Login" Height="40" 
                        Background="#2563EB" Foreground="#FFFFFF" 
                        FontSize="14" FontWeight="Bold" Cursor="Hand"
                        Click="BtnLogin_Click" IsDefault="True" Margin="0,0,0,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Exit Button -->
                <Button x:Name="btnExit" Content="Exit Application" Height="34" 
                        Background="Transparent" Foreground="#94A3B8" 
                        FontSize="12" Cursor="Hand" BorderThickness="0"
                        Click="BtnExit_Click" IsCancel="True" Margin="0,0,0,16"/>

                <!-- Default Credentials Hint -->
                <Border Background="#0F172A" CornerRadius="6" Padding="10,8" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🔑 Demo Account: " FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="admin / admin123" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Window>
